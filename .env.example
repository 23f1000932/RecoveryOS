# RecoveryOS — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env with real credentials.

# ── Database ───────────────────────────────────────────────────────────────────
# Supabase PostgreSQL connection string
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=

# ── AI ────────────────────────────────────────────────────────────────────────
# Google Gemini API key
GEMINI_API_KEY=

# ── Payments ──────────────────────────────────────────────────────────────────
# Razorpay Test Mode credentials
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay webhook signing secret (from Razorpay dashboard → Webhooks)
RAZORPAY_WEBHOOK_SECRET=

# ── Frontend ──────────────────────────────────────────────────────────────────
# Backend API base URL consumed by the React frontend (Vite exposes VITE_ prefix)
VITE_API_BASE_URL=http://localhost:8000

# ── Optional ──────────────────────────────────────────────────────────────────
# Path to saved XGBoost model file (leave empty to use RuleBasedRecoveryModel)
MODEL_PATH=

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Runtime environment: development | test | production
ENVIRONMENT=development
